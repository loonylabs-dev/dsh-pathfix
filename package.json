{
  "name": "dsh-pathfix",
  "version": "0.1.0",
  "description": "Host-layer DeepSeek Harness plugin that normalizes whitespace and trailing newlines in tool path and pattern parameters.",
  "author": "loonylabs-dev <info@loonylabs.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loonylabs-dev/dsh-pathfix.git"
  },
  "bugs": {
    "url": "https://github.com/loonylabs-dev/dsh-pathfix/issues"
  },
  "homepage": "https://github.com/loonylabs-dev/dsh-pathfix#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "pathfix",
    "normalizer"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/e2e.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "mount-check": "node acceptance/mount_check.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tool-fs": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "engines": {
    "node": ">=22"
  }
}
